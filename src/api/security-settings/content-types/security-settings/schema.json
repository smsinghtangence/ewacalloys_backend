{
  "kind": "singleType",
  "collectionName": "security_settings",
  "info": {
    "singularName": "security-settings",
    "pluralName": "security-settings-items",
    "displayName": "Security Settings",
    "description": "Settings for frontend security headers"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "contentSecurityPolicy": {
      "type": "string",
      "required": false,
      "default": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    },
    "permissionsPolicy": {
      "type": "string",
      "required": false,
      "default": "camera=(), microphone=(), geolocation=()"
    },
    "referrerPolicy": {
      "type": "string",
      "required": false,
      "default": "strict-origin-when-cross-origin"
    },
    "xFrameOptions": {
      "type": "string",
      "required": false,
      "default": "DENY"
    },
    "xContentTypeOptions": {
      "type": "string",
      "required": false,
      "default": "nosniff"
    },
    "strictTransportSecurity": {
      "type": "string",
      "required": false,
      "default": "max-age=31536000; includeSubDomains"
    }
  }
}
